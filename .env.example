# ---------- App ----------
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins, e.g. chrome-extension://<extension-id>,http://localhost:5173
CORS_ORIGINS=*

# ---------- Database ----------
# Matches docker-compose.yml (note host port 5433)
DATABASE_URL=postgresql://echogpt:echogpt@localhost:5433/echogpt?schema=public

# ---------- JWT ----------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Encryption (AI provider API keys) ----------
# Must be exactly 64 hex characters (32 bytes). Same command as above.
ENCRYPTION_KEY=replace_with_64_char_random_hex

# ---------- Web search (Tavily) ----------
# Optional. Empty = Tavily keyless mode (works out of the box, lower limits).
# Free key (1,000 searches/month): https://app.tavily.com
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# How long identical searches are served from cache (0 disables caching)
SEARCH_CACHE_TTL_SECONDS=3600

# ---------- Seed (first admin account) ----------
SEED_ADMIN_EMAIL=admin@echogpt.local
SEED_ADMIN_PASSWORD=ChangeMe123!
