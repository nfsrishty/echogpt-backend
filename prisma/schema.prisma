// ============================================================
//  EchoGPT Backend — Database Schema
//  Conventions:
//    - Model names: PascalCase (TypeScript side)
//    - Table / column names: snake_case (PostgreSQL side) via @map
//    - Primary keys: UUID (safe to expose in URLs, no enumeration)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  Enums
// ------------------------------------------------------------

enum RoleName {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum ProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

// ------------------------------------------------------------
//  Identity & Access
// ------------------------------------------------------------

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name")
  avatarUrl       String?  @map("avatar_url")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  roleId          Int      @map("role_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  role                    Role                     @relation(fields: [roleId], references: [id])
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  subscription            Subscription?
  conversations           Conversation[]
  webSearches             WebSearch[]
  apiUsageLogs            ApiUsageLog[]

  @@index([roleId])
  @@map("users")
}

/// One row per logged-in device. Only a HASH of the refresh token is stored,
/// so a database leak does not leak usable tokens.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ------------------------------------------------------------
//  Plans & Subscriptions
// ------------------------------------------------------------

/// The catalogue of plans. Limits live here, not on the subscription,
/// so changing a plan's limit updates every subscriber at once.
model Plan {
  id                Int      @id @default(autoincrement())
  tier              PlanTier @unique
  displayName       String   @map("display_name")
  dailyRequestLimit Int      @map("daily_request_limit")
  priceCents        Int      @default(0) @map("price_cents")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// A user's current subscription (one per user). Upgrading or downgrading
/// simply points planId at a different plan.
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  planId           Int                @map("plan_id")
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now()) @map("started_at")
  currentPeriodEnd DateTime?          @map("current_period_end")
  canceledAt       DateTime?          @map("canceled_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ------------------------------------------------------------
//  AI Providers
// ------------------------------------------------------------

/// API keys are ENCRYPTED (AES-256-GCM), not hashed: we must recover the
/// original key to call the provider. iv + authTag are required to decrypt.
model AiProvider {
  id              String               @id @default(uuid()) @db.Uuid
  name            String               @unique
  type            ProviderType
  defaultModel    String               @map("default_model")
  baseUrl         String?              @map("base_url")
  encryptedApiKey String               @map("encrypted_api_key")
  apiKeyIv        String               @map("api_key_iv")
  apiKeyAuthTag   String               @map("api_key_auth_tag")
  apiKeyLast4     String               @map("api_key_last4")
  isEnabled       Boolean              @default(true) @map("is_enabled")
  isDefault       Boolean              @default(false) @map("is_default")
  healthStatus    ProviderHealthStatus @default(UNKNOWN) @map("health_status")
  lastHealthCheck DateTime?            @map("last_health_check")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  conversations Conversation[]
  messages      Message[]
  webSearches   WebSearch[]
  apiUsageLogs  ApiUsageLog[]

  @@index([type])
  @@index([isEnabled])
  @@map("ai_providers")
}

// ------------------------------------------------------------
//  Chat History
// ------------------------------------------------------------

model Conversation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String?  @map("provider_id") @db.Uuid
  title      String   @default("New conversation")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id               String      @id @default(uuid()) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  role             MessageRole
  content          String      @db.Text
  providerId       String?     @map("provider_id") @db.Uuid
  model            String?
  promptTokens     Int?        @map("prompt_tokens")
  completionTokens Int?        @map("completion_tokens")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider     AiProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ------------------------------------------------------------
//  Web Search
// ------------------------------------------------------------

/// Each search a user performs (their history).
model WebSearch {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  providerId      String?  @map("provider_id") @db.Uuid
  query           String
  normalizedQuery String   @map("normalized_query")
  resultCount     Int      @default(0) @map("result_count")
  fromCache       Boolean  @default(false) @map("from_cache")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([normalizedQuery])
  @@map("web_searches")
}

/// Shared cache of search results, keyed by a hash of the normalized query.
/// Not tied to a user: two users searching the same thing share one entry.
model SearchCache {
  id              String   @id @default(uuid()) @db.Uuid
  queryHash       String   @unique @map("query_hash")
  normalizedQuery String   @map("normalized_query")
  results         Json
  aiSummary       String?  @map("ai_summary") @db.Text
  hitCount        Int      @default(0) @map("hit_count")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("search_cache")
}

// ------------------------------------------------------------
//  Usage & Request Logs
// ------------------------------------------------------------

/// One row per API request. Powers: remaining-requests quota, admin
/// analytics, and request logs. userId is SET NULL on account deletion
/// so aggregate statistics survive.
model ApiUsageLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  providerId        String?  @map("provider_id") @db.Uuid
  method            String
  path              String
  statusCode        Int      @map("status_code")
  durationMs        Int      @map("duration_ms")
  countsTowardQuota Boolean  @default(false) @map("counts_toward_quota")
  promptTokens      Int?     @map("prompt_tokens")
  completionTokens  Int?     @map("completion_tokens")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, countsTowardQuota, createdAt])
  @@index([createdAt])
  @@index([statusCode])
  @@map("api_usage_logs")
}
